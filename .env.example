# Reason reads these variables only. Sense and Act never use an LLM.
# LLM_PROVIDER selects the backend: "groq" (default), "ollama", or "openai".
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=

# Only needed when LLM_PROVIDER=ollama (e.g. LLM_MODEL=qwen:14b)
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
